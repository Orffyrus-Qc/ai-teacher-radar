# ---------- identity / time ----------
TZ=America/New_York

# ---------- LLM (Ollama on the host) ----------
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Per-item enrichment: small + fast, must leave VRAM headroom for other jobs.
LLM_MODEL=qwen3.5:9b
# Daily / weekly synthesis: bigger, better long-context reasoning.
LLM_SYNTHESIS_MODEL=gpt-oss:20b
LLM_TIMEOUT_S=300
# Reasoning models burn minutes per blurb; off for summarisation work.
LLM_THINK=false
# How many top items get a per-item LLM note.
LLM_MAX_ITEMS=10
# Set to false to produce briefs with zero LLM calls (rule-based only, no GPU).
LLM_ENABLED=true

# ---------- GPU gating ----------
# A run is "GPU-blocked" if any probe below says the GPU is busy.
GPU_GATE_ENABLED=true
# nvidia-smi thresholds (needs the gpus reservation in docker-compose.yml).
# VRAM must clear the Windows desktop baseline - dwm/Chrome/Discord hold
# ~2.7-3.2 GiB on this rig with nothing running, so 6000 is the floor that
# still catches a real model load (9B Q4 ~ 6.6 GiB, LTX render ~ 11-13 GiB).
GPU_BUSY_UTIL_PCT=25
GPU_BUSY_VRAM_MIB=6000
# Which GPU indexes to guard. Empty = all. e.g. "0" to only guard the 5060 Ti.
GPU_GUARD_INDEXES=
# External GPU-consumer queues to respect (comma separated, blank to disable)
COMFYUI_URL=http://host.docker.internal:8188
# Ollama counts as GPU-busy only if a *foreign* model is resident
OLLAMA_PS_GATE=true
# How often a deferred job re-checks the GPU, and how long it may wait.
GPU_RECHECK_S=120
GPU_MAX_DEFER_S=21600
# Harvest (pure HTTP, no GPU) even while deferred, so nothing is missed.
FETCH_WHEN_GPU_BUSY=true

# ---------- scheduling ----------
# auto  = n8n drives it; the internal cron only fires if n8n has gone quiet
# n8n   = never self-schedule (orchestrator only)
# internal = ignore n8n, always self-schedule
SCHEDULER_MODE=auto
SEARCH_SLOTS=06:00,12:00,18:00,23:00
DAILY_SYNTHESIS_AT=23:40
WEEKLY_SYNTHESIS_DOW=sun
WEEKLY_SYNTHESIS_AT=23:55
# If no n8n-sourced job arrives within this many minutes of a slot, self-fire.
N8N_GRACE_MIN=25

# ---------- sources ----------
# Network of an existing n8n container; the n8n compose override joins it,
# but only when it actually exists.
N8N_NETWORK=n8n_default

# Optional. Raises the GitHub search rate limit from 10/min to 30/min.
GITHUB_TOKEN=
LOOKBACK_HOURS=30
MAX_ITEMS_PER_SOURCE=60
SCORE_THRESHOLD=3.0
