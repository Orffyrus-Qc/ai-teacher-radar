# The Python, YAML and Dockerfile all run inside a Linux container: keep LF.
* text=auto eol=lf

# Windows-native tooling is happier with CRLF.
*.ps1   text eol=crlf
*.cs    text eol=crlf
*.csproj text eol=crlf
*.wxs   text eol=crlf
*.manifest text eol=crlf

# Binaries and RTF must never be touched.
*.ico   binary
*.png   binary
*.msi   binary
*.rtf   -text
